{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
      "outDir": "./lib",
      "declaration": true,
      "declarationMap": true,
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "downlevelIteration": true,
      "target": "es2020",
      "module": "esnext",
      "moduleResolution": "bundler",
      "baseUrl": ".",
      "paths": {
        "@shared/*": ["../../shared/*"]
      }
    },
    "include": ["src/**/*", "tests/**/*", "../../shared/**/*"]
  }
  